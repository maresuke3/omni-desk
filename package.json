{
  "name": "omni-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Slack / Chatwork / Teams / メールを一元管理するデスクトップダッシュボード（モノレポ）",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.9.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @omni-desk/desktop dev",
    "build": "pnpm --filter @omni-desk/desktop build",
    "start": "pnpm --filter @omni-desk/desktop start",
    "dist:mac": "pnpm --filter @omni-desk/desktop dist:mac",
    "dist:win": "pnpm --filter @omni-desk/desktop dist:win",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint:boundaries && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
