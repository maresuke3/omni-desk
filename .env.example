# ローカル開発用の環境変数テンプレート（実ファイルは .env.local に作成）
# Ansible を使う場合は `ansible-playbook -i ansible/inventories/dev/inventory.ini ansible/playbooks/render-env.yml --ask-vault-pass` で自動生成できます。

# Google OAuth (Google Calendar / Gmail)
OMNI_GOOGLE_CLIENT_ID=
OMNI_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OMNI_GITHUB_CLIENT_ID=
OMNI_GITHUB_CLIENT_SECRET=
